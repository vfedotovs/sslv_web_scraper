
# ws_worker container envs
DEST_EMAIL=<...>
SRC_EMAIL=<...>
RELEASE_VERSION=1.6.0

AWS_ACCESS_KEY_ID=<...>
AWS_SECRET_ACCESS_KEY=<...>

POSTGRES_PASSWORD=<DB password>

# Used for both postgres container and ws container
DB_NAME=<...>
DB_USER=<...>

CITY_MAIN_URL="https://www.ss.lv/lv/real-estate/flats/ogre-and-reg/ogre/sell/"
EMAIL_CITY_TITLE="Ogre"

# Scraper tuning (optional - defaults shown)
# Limit how many ad detail pages to scrape per run (0 = no limit).
# Since M7 P1 this applies to NEW ads only — ads already in listed_ads are
# never re-fetched, and the still/removed diff always uses the full
# discovered URL set regardless of this limit. Ads over the limit are
# fetched on later runs. 500 covers a first run into an empty DB for every
# city (jurmala, the largest, lists ~320); use 5 for quick dev runs.
SCRAPE_URL_LIMIT=500

# Seconds to wait between scraping individual ad detail pages (politeness)
SCRAPE_DELAY_SEC=5

# Seconds to wait between fetching listing pages (affects multi-page cities)
SCRAPE_LIST_DELAY_SEC=1

# Monitoring alert thresholds (M6 Item 3, optional - defaults shown)
# Max % of listed ads that may be removed in one run before an anomaly alert
ALERT_REMOVED_PCT=30

# Consecutive successful runs with zero new ads before an anomaly alert
ALERT_ZERO_NEW_RUNS=3

# Backup alerting thresholds (M6 Item 4, optional - defaults shown)
# Hard floor for a compressed backup; smaller = truncated or failed dump.
# Not an empty-DB check: small DBs dump to 2-8 KB. fleet_watchdog.py compares
# the size with the live row count and with the previous backups instead.
MIN_BACKUP_SIZE_KB=1

# Backup container and fleet_watchdog.py (optional - defaults shown):
# backup below MIN_BACKUP_SIZE_KB + rows x this = warning (may lack data).
# Calibrate with `make backup-sizes`; the watchdog also takes a per-city
# backup_min_bytes_per_row under the city in config/cities.yaml
BACKUP_MIN_BYTES_PER_ROW=5
# fewer rows than this fraction of the previous backup's (backup.py) or of the
# dump's vs the live DB (watchdog) = critical data loss; a backup below this
# fraction of the previous backups' median size = warning
BACKUP_SHRINK_RATIO=0.5

# fleet_watchdog.py only (optional - default shown):
# previous backups the shrink check compares with (needs at least 3)
BACKUP_HISTORY_N=7

# Alert if the newest S3 backup is older than this many hours
BACKUP_MAX_AGE_HOURS=26

