# Installed by `make watchdog-install` (@REPO_DIR@ / @USER@ are substituted).
# Daily heartbeat: always pushes (low priority when healthy) and emails via SES
# only on problems. A missing heartbeat means the watchdog itself is broken.
[Unit]
Description=SSLV fleet watchdog - daily ntfy heartbeat
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=/etc/sslv-watchdog.env
ExecStart=/usr/bin/python3 scripts/fleet_watchdog.py --email-mode problems --ntfy-mode always
SuccessExitStatus=1
